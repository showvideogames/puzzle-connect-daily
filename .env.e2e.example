# The end-to-end test environment's configuration — EXAMPLE ONLY.
#
# You do not write .env.e2e by hand. `npm run e2e:up` starts the disposable
# local Supabase stack and writes the real file from that stack's own
# `supabase status` output, so no key is ever copied, guessed, or committed.
# This file exists to document the shape, and so that the values a reader is
# looking for are visibly NOT here.
#
# Every value below must point at a local test instance. If any of them ever
# names a hosted project, the harness refuses to run at all — see
# e2e/safety.ts (and the matching bundler-level check in vite.config.ts for
# `--mode e2e`). There is no fallback to production, by design.
#
# See e2e/README.md.

# --- Read by the browser bundle (Vite inlines every VITE_ variable) ---------

# The local Supabase API gateway. Must be loopback.
VITE_SUPABASE_URL=http://127.0.0.1:54421

# The local stack's anon (publishable) key: a demo JWT the CLI generates,
# issued by "supabase-demo" and worthless outside your own containers.
VITE_SUPABASE_PUBLISHABLE_KEY=<written by `npm run e2e:up`>

# The support CTA on custom puzzle pages is hidden when this is unset, and
# e2e/tests/custom.spec.ts asserts exactly that — so it stays empty.
VITE_SUPPORT_URL=

# --- Server side only: never reaches the browser ---------------------------

# The local stack's service-role key. Used by the seeder to create fixture
# accounts and by a few test helpers to inspect the database directly.
E2E_SERVICE_ROLE_KEY=<written by `npm run e2e:up`>

# The local Postgres the schema is applied to.
E2E_DB_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

# Where Playwright expects the application under test.
E2E_APP_URL=http://127.0.0.1:5183

# --- Optional --------------------------------------------------------------

# Extra hostnames to treat as disposable, comma separated. Only needed when
# the stack is reachable under a container hostname rather than loopback
# (some CI networks). It can never override the guard's deny list, so it
# cannot be used to point the suite at a hosted project.
# E2E_EXTRA_DISPOSABLE_HOSTS=supabase-kong

# Per-action timeout for browser interactions, milliseconds.
# E2E_ACTION_TIMEOUT_MS=15000
