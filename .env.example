# Public configuration only. Never put secrets in a VITE_ variable: Vite
# inlines every one of them into the browser bundle.

# Where the "Keep the Puzzles Coming" button on custom puzzle pages sends
# people (e.g. a Ko-fi or Stripe payment link). Must be a full http(s) URL.
# Leave unset/empty and the button (and its supporting sentence) is not shown.
# Production: set it in the hosting provider's environment variables
# (Lovable/Vercel project settings) and redeploy; it is read at build time.
VITE_SUPPORT_URL=
