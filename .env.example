# Public configuration only. Never put secrets in a VITE_ variable: Vite
# inlines every one of them into the browser bundle.
#
# Everything project- or environment-specific about Rainbow lives in values
# like these (see docs/CONFIG-INVENTORY.md for the complete list, including
# the Supabase dashboard settings). Moving Rainbow to another Supabase
# project, or pointing it at another sign-in environment, changes values
# here and nothing in the code.

# The Supabase project Rainbow/Mini use. Read at build time.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The shared sign-in service (WorkOS AuthKit): its OpenID discovery document,
# e.g. https://<authkit-domain>/.well-known/openid-configuration. Used only
# as a reachability probe before leaving for the sign-in page. Leave empty
# and accounts are switched OFF: the game is guest-only, no sign-in surface
# is shown, nothing else changes.
VITE_PLATFORM_DISCOVERY_URL=

# Emergency switch: set to "false" to hide every sign-in surface even when the
# discovery URL is configured (guests, stats, Mini, custom puzzles keep
# working; existing sessions are left alone). Anything else means on.
VITE_ACCOUNTS_ENABLED=

# Cloudflare Turnstile site key for the feedback form (the secret key lives
# in the submit-feedback edge function's secrets, never here).
VITE_TURNSTILE_SITE_KEY=

# Where Mini share text points people (defaults to rainbowcategories.com/mini).
VITE_MINI_SHARE_URL=

# Where the "Keep the Puzzles Coming" button on custom puzzle pages sends
# people (e.g. a Ko-fi or Stripe payment link). Must be a full http(s) URL.
# Leave unset/empty and the button (and its supporting sentence) is not shown.
# Production: set it in the hosting provider's environment variables
# (Vercel project settings) and redeploy; it is read at build time.
VITE_SUPPORT_URL=
